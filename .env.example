# Local development — SQLite, no external DB needed
DATABASE_URL=sqlite:///./gradedfacts.db

# Production — set to your PostgreSQL connection string
# Format: postgresql://user:password@host:5432/dbname
# Note: postgres:// is also accepted (auto-normalised to postgresql://)
# DATABASE_URL=postgresql://gradedfacts:password@postgres-host:5432/gradedfacts

ANTHROPIC_API_KEY=your_key_here
MISTRAL_API_KEY=your_key_here
BRAVE_API_KEY=your_key_here
RATE_LIMIT_ENABLED=true
ENVIRONMENT=production
